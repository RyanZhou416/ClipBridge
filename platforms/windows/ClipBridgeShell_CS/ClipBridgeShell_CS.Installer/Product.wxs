<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" 
           Name="ClipBridge Shell" 
           Language="2052" 
           Codepage="936"
           Version="1.0.9.0" 
           Manufacturer="Ryan416" 
           UpgradeCode="a1b2c3d4-e5f6-7890-abcd-ef1234567891">
    
    <Package InstallerVersion="200" 
             Compressed="yes" 
             InstallScope="perMachine"
             Languages="2052"
             SummaryCodepage="936"
             Description="ClipBridge Shell 安装程序"
             Comments="ClipBridge Shell - 跨设备剪贴板同步工具"
             Manufacturer="Ryan416" />
    
    <MajorUpgrade DowngradeErrorMessage="检测到更高版本的 ClipBridge Shell 已安装。请先卸载旧版本。" />
    
    <MediaTemplate EmbedCab="yes" />
    
    <Icon Id="AppIcon" SourceFile="$(var.AppProjectDir)\Assets\WindowIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    
    <!-- 安装目录：默认 C:\Program Files\ClipBridge -->
    <SetDirectory Id="INSTALLFOLDER" Value="[ProgramFiles64Folder]ClipBridge" />
    
    <!-- 允许用户修改路径 -->
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!--
      卸载时是否同时删除用户数据（%LOCALAPPDATA%\ClipBridge：core.db/logs.db/Cache/tls）。
      默认 0 = 保留（重装后可继续使用）；卸载向导会弹出自定义对话框让用户勾选，
      静默卸载可用：msiexec /x ClipBridgeShell_CS.msi REMOVEUSERDATA=1 /qn
    -->
    <Property Id="REMOVEUSERDATA" Value="0" />

    <!-- 卸载向导：在「维护类型」页点“删除”后插入我们的数据清理对话框。 -->
    <UI>
      <DialogRef Id="RemoveUserDataDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="RemoveUserDataDlg" Order="2">1</Publish>
      <Publish Dialog="RemoveUserDataDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">1</Publish>
      <Publish Dialog="RemoveUserDataDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2">1</Publish>
      <Publish Dialog="RemoveUserDataDlg" Control="Cancel" Event="SpawnDialog" Value="CancelDlg" Order="2">1</Publish>
    </UI>

    <!--
      卸载清理动作（deferred，Impersonate=yes 让 %LOCALAPPDATA% 指向执行卸载的用户）：
      1) CleanupStartupEntryCA：总是移除开机自启项与旧版计划任务（这些是应用运行时写入的，
         MSI 组件不跟踪，必须显式清理，否则卸载后残留“开机启动”死项）。
      2) RemoveUserDataCA：仅在用户勾选（REMOVEUSERDATA=1）时删除用户数据目录。
      两者都 Return="ignore"：清理失败不能阻断卸载。
    -->
    <CustomAction Id="CleanupStartupEntryCA"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c reg delete &quot;HKCU\SOFTWARE\Microsoft\Windows\CurrentVersion\Run&quot; /v ClipBridge /f &amp; schtasks /Delete /TN ClipBridge_AutoStart /F" />
    <CustomAction Id="RemoveUserDataCA"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c rd /s /q &quot;%LOCALAPPDATA%\ClipBridge&quot;" />

    <InstallExecuteSequence>
      <Custom Action="CleanupStartupEntryCA" Before="InstallFinalize">Installed AND (REMOVE~=&quot;ALL&quot;)</Custom>
      <Custom Action="RemoveUserDataCA" Before="InstallFinalize">REMOVEUSERDATA=&quot;1&quot; AND Installed AND (REMOVE~=&quot;ALL&quot;)</Custom>
    </InstallExecuteSequence>
    
    <Feature Id="ProductFeature" Title="ClipBridge Shell" Level="1">
      <ComponentGroupRef Id="RuntimeFiles" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
      <ComponentGroupRef Id="DesktopShortcut" />
      <ComponentGroupRef Id="RegistryEntries" />
      <ComponentGroupRef Id="CleanupComponents" />
    </Feature>
    
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ClipBridge" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ClipBridge" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
      <!-- 自定义动作（deferred cmd.exe）的工作目录引用：SystemFolder 是标准目录，必须在 Directory 树中出现一次。 -->
      <Directory Id="SystemFolder" />
    </Directory>
  </Product>
  
  <!-- 辅助组件组：负责清理和目录创建 -->
  <Fragment>
    <ComponentGroup Id="CleanupComponents" Directory="INSTALLFOLDER">
      <Component Id="CleanupMainDir" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567892">
        <CreateFolder />
        <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER" />
      </Component>
    </ComponentGroup>
  </Fragment>
  
  <Fragment>
    <ComponentGroup Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567894">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="ClipBridge Shell"
                  Description="ClipBridge Shell - 跨设备剪贴板同步工具"
                  Target="[INSTALLFOLDER]ClipBridgeShell_CS.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ClipBridge\ClipBridgeShell" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
  
  <Fragment>
    <ComponentGroup Id="DesktopShortcut" Directory="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567895">
        <Shortcut Id="DesktopShortcut"
                  Name="ClipBridge Shell"
                  Description="ClipBridge Shell - 跨设备剪贴板同步工具"
                  Target="[INSTALLFOLDER]ClipBridgeShell_CS.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\ClipBridge\ClipBridgeShell" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
  
  <Fragment>
    <ComponentGroup Id="RegistryEntries" Directory="INSTALLFOLDER">
      <Component Id="RegistryEntries" Guid="a1b2c3d4-e5f6-7890-abcd-ef1234567896">
        <RegistryKey Root="HKLM" Key="SOFTWARE\ClipBridge\ClipBridgeShell">
          <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="Version" Type="string" Value="1.0.9.0" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>
  <!-- 卸载时的“是否删除用户数据”对话框。 -->
  <Fragment>
    <UI>
      <Dialog Id="RemoveUserDataDlg" Width="370" Height="270" Title="卸载 ClipBridge Shell" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}卸载 ClipBridge Shell" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="是否同时删除本机的用户数据？" />
        <Control Id="RemoveUserDataCheckBox" Type="CheckBox" X="25" Y="50" Width="320" Height="18"
                 Property="REMOVEUSERDATA" CheckBoxValue="1"
                 Text="删除用户数据（历史记录、缓存、设备证书与配对信任）" />
        <Control Id="DataDetail" Type="Text" X="25" Y="72" Width="320" Height="90"
                 Transparent="yes" NoPrefix="yes"
                 Text="删除后无法恢复：将移除 %LOCALAPPDATA%\ClipBridge 下的数据库、缓存、设备证书，其他设备上的数据不受影响。不勾选则保留，重新安装后可继续使用（推荐）。" />
        <Control Id="StartupDetail" Type="Text" X="25" Y="165" Width="320" Height="40"
                 Transparent="yes" NoPrefix="yes"
                 Text="无论是否勾选，卸载都会移除开机自启项和开始菜单/桌面快捷方式。" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)" />
      </Dialog>
    </UI>
  </Fragment>
</Wix>