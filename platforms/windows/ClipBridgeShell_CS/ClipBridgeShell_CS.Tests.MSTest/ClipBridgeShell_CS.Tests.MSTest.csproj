<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>ClipBridgeShell_CS.Tests.MSTest</RootNamespace>
    <Platforms>x86;x64;arm64</Platforms>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
	<WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!--
      Microsoft.NET.Test.Sdk only forces OutputType=Exe (and the generated entry point that
      produces a *.runtimeconfig.json) when UseWinUI != 'true'. Without a runtimeconfig the
      VSTest testhost aborts with "testhost.runtimeconfig.json was not found". The WinUI
      app-model is not needed to run this suite (all tests are plain [TestMethod]s), so force
      the normal test-host layout while keeping UseWinUI for the MSTest WinUI adapter assets.
    -->
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>true</GenerateProgramFile>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.2" />
    <PackageReference Include="WinUI3Localizer" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClipBridgeShell_CS\ClipBridgeShell_CS.csproj" />
  </ItemGroup>
</Project>
