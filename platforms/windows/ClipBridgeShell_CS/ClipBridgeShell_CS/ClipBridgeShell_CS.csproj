<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClipBridgeShell_CS</RootNamespace>
    <ApplicationIcon>Assets/WindowIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;arm64</Platforms>
    <PublishProfile>Properties\PublishProfiles\win10-$(Platform).pubxml</PublishProfile>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	
	<UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- 发布时默认做 ReadyToRun 预编译（Release）。实测收益：交替 A/B 9 对，
         配对差值中位数 -37.5ms，8/9 对同向（无 R2R 369.9ms → 有 R2R 326.2ms）。
         代价是发布体积增大（232.9MB → 285.5MB）与发布耗时，只作用于 publish，不影响
         日常 dotnet build 的内循环。已有 pubxml 里显式设置的 PublishReadyToRun 会覆盖这里。

         关于 WindowsAppSDKSelfContained=false（framework-dependent）的实测结论：
         在本机无法运行 —— 项目引用 WindowsAppSDK 2.0.1，而该版本要求的
         WindowsAppRuntime 2.0.x 未安装（机器上只有 2.3~2.6），启动即抛
         COMException 0x80040154 (REG_CALSSNOTREG) 于 DeploymentManager 自动初始化。
         即：换成 framework-dependent 不是免费加速，而是给用户增加一个运行时前置条件，
         且收益未经验证，因此保持 self-contained。 -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>2394034BFA5A743FA9A4320E10E6475D2A516719</PackageCertificateThumbprint>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Auto</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <!--
      缺省从工作区根目录推导 Rust 输出目录（repo/target/x86_64-pc-windows-msvc/release）。
      本文件位于 repo/platforms/windows/ClipBridgeShell_CS/ClipBridgeShell_CS/，所以要上溯 4 层。
      仍然可以用 -p:RustTargetDir=<dir> 覆盖，避免把某台开发机的绝对路径写进仓库。
    -->
    <RustTargetDir Condition="'$(RustTargetDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\target\x86_64-pc-windows-msvc\release</RustTargetDir>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

<ItemGroup>
  <Content Include="Assets\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
  <Content Include="Strings\**\*.resw">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>

<ItemGroup>
  <None Remove="Views\HistoryPage.xaml" />
</ItemGroup>


  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Triggers" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
    <PackageReference Include="WinUI3Localizer" Version="2.3.0" />
    <!-- WinUIEx 已移除：MainWindow 改为直接继承 Microsoft.UI.Xaml.Window（实测基类构造 87ms， 
         移除后 -35.1ms，9/9 对同向）。它提供的 Show/Hide/BringToFront/最小尺寸/提示对话框
         已在 Helpers/WindowExtensions.cs 里按原实现逐字重建。 -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipBridgeShell_CS.Core\ClipBridgeShell_CS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Page Update="Views\HistoryPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!-- 将 core_ffi_windows.dll 作为 Content 项包含，确保 MSIX 打包时包含它 -->
  <!-- 直接指向源文件，MSBuild 会自动处理复制到输出目录和打包 -->
  <ItemGroup>
    <Content Include="$(RustTargetDir)\core_ffi_windows.dll" Condition="Exists('$(RustTargetDir)\core_ffi_windows.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>core_ffi_windows.dll</Link>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
  
  <!--
    构建前先编译 Rust core-ffi，保证 C# 侧永远使用刚构建的 core_ffi_windows.dll。
    背景：此前的流程只按路径 Exists 拷贝 DLL，结果静默加载了一个 6 个月前的旧 DLL，
    导致所有 Rust 侧修复（包括安全修复）根本没有进入实际运行的程序。
    - 需要 Rust 工具链；cargo 是增量的，未改动时通常 <1s。
    - 用 -p:SkipRustBuild=true 可跳过（例如 CI 的纯 C# 作业）。
    - cargo 不可用或构建失败时只发 Warning，不阻断 C# 构建，但会明确提示 DLL 可能是旧的。
  -->
  <PropertyGroup>
    <CliBridgeRepoRoot>$(MSBuildThisFileDirectory)..\..\..\..</CliBridgeRepoRoot>
    <SkipRustBuild Condition="'$(SkipRustBuild)' == ''">false</SkipRustBuild>
    <!--
      发布瘦身：默认开启（`-p:TrimPublishOutput=false` 可关闭）。
      - 移除 Windows App SDK 的 AI/ML 组件：onnxruntime.dll(20.7MB) + DirectML.dll(17.8MB)
        + Microsoft.Windows.AI.* / Microsoft.ML.OnnxRuntime.*（合计约 42.4MB）。本应用
        不调用任何 Windows.AI/ML API（代码里没有任何引用），这些文件是
        Microsoft.WindowsAppSDK 元包顺带带进来的；缺失只会在调用 AI API 时才报错。
      - 移除除保留语言外的 WinUI 运行时 MUI 目录（86 个语言约 3.4MB）。应用自身
        文案走 Strings/*.resw（WinUI3Localizer），WinUI 运行时 MUI 只在系统语言
        不是保留语言时才被用到，缺失时按 en-US 回退。
      实测（release x64 publish）：287.1MB → 244.9MB（-42.2MB）。
    -->
    <TrimPublishOutput Condition="'$(TrimPublishOutput)' == ''">true</TrimPublishOutput>
    <!-- 保留的发布输出子目录（大小写按实际目录名）；语言目录只留这些。 -->
    <TrimKeepPublishDirs Condition="'$(TrimKeepPublishDirs)' == ''">Assets;Strings;Microsoft.UI.Xaml;zh-CN;zh-TW;en-us;en-US</TrimKeepPublishDirs>
  </PropertyGroup>

  <Target Name="BuildCoreFfi" BeforeTargets="BeforeBuild" Condition="'$(SkipRustBuild)' != 'true'">
    <Message Importance="high" Text="[core-ffi] cargo build -p core-ffi-windows --release --target x86_64-pc-windows-msvc" />
    <Exec Command="cargo build -p core-ffi-windows --release --target x86_64-pc-windows-msvc"
          WorkingDirectory="$(CliBridgeRepoRoot)"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="normal">
      <Output TaskParameter="ExitCode" PropertyName="RustBuildExitCode" />
    </Exec>
    <Warning Condition="'$(RustBuildExitCode)' != '0'"
             Text="[core-ffi] cargo build failed (exit $(RustBuildExitCode)); the app will load $(RustTargetDir)\core_ffi_windows.dll which may be STALE. Install the Rust toolchain or pass -p:SkipRustBuild=true." />
  </Target>

  <!-- 备用：复制 core_ffi_windows.dll 到输出目录（Content 项应该已经处理了） -->
  <Target Name="CopyCoreFfiDll" AfterTargets="Build">
    <Message Text="Copying core_ffi_windows.dll from Rust target to $(OutDir)" Importance="high" />
    <!--
      Release 构建缺少 core_ffi_windows.dll 时不再静默通过（运行期会 DllNotFoundException，
      CoreHostService 只会报告 Degraded）。用 -p:SkipCoreFfiCheck=true 可显式关掉该检查。
    -->
    <Warning Condition="'$(Configuration)' == 'Release' and '$(SkipCoreFfiCheck)' != 'true' and !Exists('$(RustTargetDir)\core_ffi_windows.dll')"
             Text="core_ffi_windows.dll was not found in '$(RustTargetDir)'. The resulting app will fail at runtime with DllNotFoundException (CoreHostService reports 'Degraded'). Build the Rust core-ffi crate (cargo build -p core_ffi_windows --release --target x86_64-pc-windows-msvc) or pass -p:RustTargetDir=&lt;dir&gt;. Set -p:SkipCoreFfiCheck=true to suppress this warning." />
    <Copy SourceFiles="$(RustTargetDir)\core_ffi_windows.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(RustTargetDir)\core_ffi_windows.dll')" />
  </Target>

  <!--
    发布瘦身（见上面的 TrimPublishOutput 注释）：只作用于 publish 产物，不影响
    dotnet build / 测试 / 运行时调试。宿主若将来要用 Windows.AI，把
    -p:TrimPublishOutput=false 传给 publish 即可。
  -->
  <Target Name="TrimPublishOutputs" AfterTargets="Publish" Condition="'$(TrimPublishOutput)' != 'false'">
    <!-- 1) AI/ML 组件（本应用不使用）。 -->
    <ItemGroup>
      <_AiPublishFile Include="$(PublishDir)onnxruntime.dll" />
      <_AiPublishFile Include="$(PublishDir)DirectML.dll" />
      <_AiPublishFile Include="$(PublishDir)Microsoft.Windows.AI*.dll" />
      <_AiPublishFile Include="$(PublishDir)Microsoft.Windows.AI*.winmd" />
      <_AiPublishFile Include="$(PublishDir)Microsoft.ML.OnnxRuntime*.dll" />
    </ItemGroup>
    <ItemGroup>
      <_AiPublishFileExisting Include="@(_AiPublishFile)" Condition="Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="@(_AiPublishFileExisting)" />

    <!-- 2) 未保留语言的 WinUI 运行时 MUI 目录。
         用 Directory.GetDirectories 枚举（MSBuild 的 * 通配符无法只匹配目录）。 -->
    <ItemGroup>
      <_PublishSubDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
      <!-- 属性要先拆成 item 才能做 %(Identity) 变换。 -->
      <_TrimKeepName Include="$(TrimKeepPublishDirs)" />
      <_TrimKeepDir Include="@(_TrimKeepName->'$(PublishDir)%(Identity)')" />
      <_PublishDirToRemove Include="@(_PublishSubDir)" Exclude="@(_TrimKeepDir)" />
    </ItemGroup>
    <RemoveDir Directories="@(_PublishDirToRemove)" />

    <Message Importance="high"
             Text="[trim] removed @(_AiPublishFileExisting->Count()) AI/ML file(s) and @(_PublishDirToRemove->Count()) unused culture dir(s) from $(PublishDir)" />
  </Target>
</Project>
